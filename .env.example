# Copie para .env e preencha. Nunca versione o .env.
# Segredo do JWT: no mínimo 32 caracteres aleatórios (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=
JWT_EXPIRES_IN=1d
PORT=3000
# Caminho do SQLite; padrão: src/database/database.sqlite
DATABASE_FILE=
# Origem permitida no CORS (ex.: https://valoriza-web.vercel.app); * libera todas
CORS_ORIGIN=*
BCRYPT_COST=10
# Admin garantido na subida (útil no Render gratuito, sem Shell e com disco temporário). Deixe vazio para não criar.
ADMIN_EMAIL=
ADMIN_PASSWORD=
